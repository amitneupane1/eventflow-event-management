<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Existing files and folders should continue working
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route organization names to the organization page
RewriteRule ^([A-Za-z0-9][A-Za-z0-9_-]*)/?$ organization-page.php?slug=$1 [QSA,L]
</IfModule>